# clangd reads out/build/<preset>/compile_commands.json through the
# compile_commands.json symlink in the repository root.
CompileFlags:
  # nvcc-only options that clang does not understand
  Remove:
    - -forward-unknown-to-host-compiler
    - -arch=*
    - -rdc=*
    - -Xcompiler*
    - --expt-relaxed-constexpr
  Add:
    - -Wno-unknown-cuda-version
